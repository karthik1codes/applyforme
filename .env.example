# One .env for everything (Python agents + Next.js dashboard).

# --- LLM (required) ---
OPENAI_API_KEY=sk-...
# Using an OpenRouter key (starts with sk-or-v1-)? Also set both:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# APPLYFORME_MODEL=openai/gpt-4o-mini

# --- Crustdata (optional company enrich; job search off by default — credits!) ---
# https://docs.crustdata.com/ — /company/enrich ≈ 2 credits each; /job/search ≈ 0.03/result
# CRUSTDATA_API_KEY=cd_...
# CRUSTDATA_JOB_SEARCH=0              # 1 = also pull Crustdata job index (costs credits)
# CRUSTDATA_JOB_LIMIT_PER_TITLE=10    # max results per target title when job search on
# CRUSTDATA_MAX_ENRICH_PER_RUN=5      # max paid company enrich calls per discover/enrich run
# CRUSTDATA_MAX_CREDITS_PER_RUN=25    # soft budget; stops when estimated spend hits this
# APPLYFORME_BROWSER_HEADED=1         # show Chromium while preparing (you can edit/stop)
# APPLYFORME_BROWSER_SLOW_MO=80       # ms delay between Playwright actions (easier to follow)
# APPLYFORME_APPLY_TIMEOUT_SEC=180    # hard ceiling for browser automation
# APPLYFORME_REVIEW_TIMEOUT_SEC=600   # how long a filled form waits for your review/submit
# APPLYFORME_APPLY_WATCH_SEC=45       # dry-run only: leave the filled form visible
# APPLYFORME_LINKEDIN_LOGIN_SEC=300   # time to finish manual LinkedIn sign-in/2FA in the browser
# LinkedIn password autofill is intentionally removed. Sign in yourself in the
# Chromium window at an authentication wall; the agent never stores passwords.
# --- Firecrawl (optional): cloud browser for Apply ---
# npx -y firecrawl-cli@latest init --all --browser   # or paste a key from firecrawl.dev
# FIRECRAWL_API_KEY=fc-...
# APPLYFORME_APPLY_ENGINE=playwright  # playwright|firecrawl (playwright is the safe default)
# APPLYFORME_LINKEDIN_ENGINE=auto     # auto: headless workers use Firecrawl live view for LinkedIn
# FIRECRAWL_BROWSER_PROFILE=applyforme  # persistent cookies for your own Firecrawl session
# Firecrawl Apply: one owned cloud browser session (POST /v2/interact) driven by
# the same deterministic Playwright code as the local browser over CDP. No AI
# browser agent in the loop, so a run costs 2 credits/min instead of 7.
# The profile has exactly one writer, so a crashed run's session is reclaimed
# automatically before the next run.
# OPENAI_BASE_URL=                  # OpenAI-compatible endpoint; required for OpenRouter
# APPLYFORME_MODEL=gpt-4o-mini      # for OpenRouter use e.g. openai/gpt-4o-mini
# APPLYFORME_JUDGE=0                # 1 = extra LLM audit on tailored resumes (slower)
# GEMINI_API_KEY=                   # alternative free provider; ignored if OPENAI_API_KEY is set

# --- Applied inbox (optional): read-only IMAP, matches employer emails to applied jobs ---
# Gmail: enable 2FA, then create an App Password.   Run: python -m applyforme inbox
# IMAP_HOST=imap.gmail.com
# IMAP_USER=you@gmail.com
# IMAP_PASSWORD=
# IMAP_FOLDER=INBOX

# --- WhatsApp Cloud API (optional): see the /whatsapp page for the setup checklist ---
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_NUMBER=         # digits with country code, e.g. 15551234567
# WHATSAPP_APP_SECRET=              # used to verify webhook signatures (required)
# WHATSAPP_VERIFY_TOKEN=            # any random string you also enter in Meta's webhook settings

# --- Payments (optional): Dodo Payments Checkout on the /billing page ---
# Docs: https://docs.dodopayments.com/developer-resources/integration-guide
# DODO_PAYMENTS_API_KEY=             # Developer → API Keys (test_mode key while building)
# DODO_PAYMENTS_ENVIRONMENT=test_mode  # or live_mode
# DODO_PAYMENTS_PRODUCT_PRO=pdt_...  # subscription product for Pro ($19/mo)
# DODO_PAYMENTS_PRODUCT_MAX=pdt_...  # subscription product for Unlimited ($49/mo)
# DODO_PAYMENTS_WEBHOOK_KEY=         # Developer → Webhooks signing secret
# DODO_PAYMENTS_RETURN_URL=http://localhost:3000/billing?checkout=success
# BILLING_CURRENCY=usd              # e.g. inr
# APP_URL=http://localhost:3000     # used for checkout return URLs + Auth.js


# --- Google sign-in (landing page + protected dashboard) ---
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: https://YOUR-HOST (and http://localhost:3000 for local)
# Authorized redirect URIs (exact — Auth.js needs the callback path):
#   https://YOUR-HOST/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OAuth consent: set Publishing status to "In production" so ANY Google/Gmail account can sign in.
# (Testing mode only allows listed test users.) Add each tunnel's /api/auth/callback/google redirect URI.
# AUTH_SECRET=                       # openssl rand -base64 32
# AUTH_URL=https://YOUR-HOST         # public URL (Cloudflare tunnel or localhost)
# NEXTAUTH_URL=https://YOUR-HOST     # same as AUTH_URL
# AUTH_DISABLED=0                    # 1 = skip Google; open dashboard without sign-in


# --- LinkedIn connector (per-user OAuth 2.0, optional) ---
# Official OpenID Connect only: openid profile email → /v2/userinfo.
# LinkedIn does NOT expose public APIs for job search, saved jobs, Easy Apply,
# or application submission; the connector does not claim otherwise.
# Create an app at https://developer.linkedin.com/ and add this exact redirect URI:
#   http://localhost:3000/api/linkedin/callback   (or https://YOUR-HOST/api/linkedin/callback)
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URI=               # optional; defaults to ${APP_URL}/api/linkedin/callback
# LINKEDIN_TOKEN_KEY=                  # REQUIRED: base64-encoded 32 random bytes, e.g.:
#                                      #   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Tokens are AES-256-GCM encrypted in SQLite. Never commit the key.
# If LINKEDIN_TOKEN_KEY is missing/invalid, the connector stays disabled and
# never falls back to plaintext storage.


# --- Pipeline worker (EC2 production + local dashboard) ---
# Production: deploy/ec2/launch-ec2.sh → systemd applyforme-worker + applyforme-web on the instance.
# Local:      python -m applyforme dashboard  (starts UI + worker together)
# Frontend → POST /api/pipeline/webhook  {"stage":"run"|"internships"|"inbox"|"apply"}
# Worker   → POST /hooks/*  Authorization: Bearer $PIPELINE_WEBHOOK_SECRET
# PIPELINE_WEBHOOK_SECRET=           # openssl rand -hex 32
# PIPELINE_WORKER_URL=http://127.0.0.1:8787   # same-box on EC2; never expose 8787 publicly
# PIPELINE_HOST=127.0.0.1
# PIPELINE_PORT=8787
# SCHEDULE_RUN=0 */4 * * *           # jobs lane: discover→tailor; "off" to disable
# SCHEDULE_INTERNSHIPS=15 */6 * * *  # internships lane (parallel with jobs)
# SCHEDULE_INBOX=30 */6 * * *        # IMAP inbox poll
# SCHEDULE_LIMIT=40
# JOB_RETENTION_DAYS=10              # drop untouched listings older than N days (0 disables)
#                                    # applied / tailored / manual jobs are never auto-removed
# CAPTCHA: automatic/third-party solving is disabled. A detected challenge
# stops the workflow and asks you to solve it in the Chromium window.
# APPLYFORME_CAPTCHA_WAIT_SEC=120    # headed mode: time to solve it yourself

# ALLOW_AUTO_APPLY=0                 # bulk prepare only; a single dashboard application never auto-submits
# PIPELINE_TIMEOUT_SEC=3600
# PYTHONUTF8=1
