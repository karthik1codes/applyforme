# One .env for everything (Python agents + Next.js dashboard).

# --- LLM (required) ---
OPENAI_API_KEY=sk-...
# APPLYFORME_MODEL=gpt-4o-mini      # default; use gpt-4o / gpt-4.1 for higher quality
# OPENAI_BASE_URL=                  # only for OpenAI-compatible endpoints (e.g. Ollama)
# GEMINI_API_KEY=                   # alternative free provider; ignored if OPENAI_API_KEY is set

# --- Applied inbox (optional): read-only IMAP, matches employer emails to applied jobs ---
# Gmail: enable 2FA, then create an App Password.   Run: python -m applyforme inbox
# IMAP_HOST=imap.gmail.com
# IMAP_USER=you@gmail.com
# IMAP_PASSWORD=
# IMAP_FOLDER=INBOX

# --- WhatsApp Cloud API (optional): see the /whatsapp page for the setup checklist ---
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_NUMBER=         # digits with country code, e.g. 15551234567
# WHATSAPP_APP_SECRET=              # used to verify webhook signatures (required)
# WHATSAPP_VERIFY_TOKEN=            # any random string you also enter in Meta's webhook settings

# --- Payments (optional): Stripe Checkout on the /billing page ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # from `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# BILLING_CURRENCY=usd              # e.g. inr
# APP_URL=http://localhost:3000     # used for Stripe return URLs + Auth.js

# --- Google sign-in (landing page + protected dashboard) ---
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_SECRET=                       # openssl rand -base64 32
# AUTH_URL=http://localhost:3000
# AUTH_DISABLED=1                    # skip Google; open the dashboard locally without sign-in

# --- Pipeline worker (EC2 scheduler + webhooks) ---
# Run on the server:  python -m applyforme serve
# Public trigger (via Next proxy): POST /api/pipeline/webhook  {"stage":"run"}
# PIPELINE_WEBHOOK_SECRET=           # openssl rand -hex 32   (required for /hooks/*)
# PIPELINE_WORKER_URL=http://127.0.0.1:8787
# PIPELINE_HOST=127.0.0.1
# PIPELINE_PORT=8787
# SCHEDULE_RUN=0 */4 * * *           # cron: full discover→tailor every 4 hours; "off" to disable
# SCHEDULE_INBOX=30 */6 * * *        # cron: IMAP inbox poll
# SCHEDULE_LIMIT=40
# ALLOW_AUTO_APPLY=0                 # set 1 only if you accept webhook-triggered --yes applies
# PIPELINE_TIMEOUT_SEC=3600
