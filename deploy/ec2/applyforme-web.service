[Unit]
Description=applyforme Next.js dashboard (EC2)
After=network-online.target applyforme-worker.service
Wants=applyforme-worker.service

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/applyforme/dashboard
EnvironmentFile=/opt/applyforme/.env
Environment=PIPELINE_WORKER_URL=http://127.0.0.1:8787
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=0.0.0.0
ExecStart=/usr/bin/npm run start -- -p 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
