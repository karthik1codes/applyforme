[Unit]
Description=applyforme Next.js dashboard
After=network.target applyforme-worker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/applyforme/dashboard
EnvironmentFile=/opt/applyforme/.env
# Next loads root .env via next.config; expose worker URL for the proxy.
Environment=PIPELINE_WORKER_URL=http://127.0.0.1:8787
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/npm run start -- -p 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
